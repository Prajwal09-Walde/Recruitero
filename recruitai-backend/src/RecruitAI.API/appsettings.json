{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "MongoDB": "REPLACE_FROM_ENV"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_32+_CHAR_SECRET_KEY_HERE!!",
    "Issuer": "RecruitAI",
    "Audience": "RecruitAI.Clients",
    "ExpiryMinutes": 60
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1",
    "S3": {
      "BucketName": "recruitai-resumes"
    }
  },
  "OpenAI": {
    "ApiKey": "REPLACE_FROM_ENV",
    "Endpoint": "https://api.openai.com/"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": "6334"
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://app.recruitai.io"
  ],
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "AllowedHosts": "*"
}
